BOT_TOKEN=
OPENAI_API_KEY=
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_IDS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_CALLBACK_HOST=127.0.0.1
GOOGLE_OAUTH_CALLBACK_PORT=8080
GOOGLE_OAUTH_CALLBACK_USE_FAKE_EXCHANGER=0
# Fernet key placeholder only. Generate outside git: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_CRYPTO_SECRET=
GOOGLE_DRIVE_ENABLED=0
GOOGLE_DRIVE_MODE=service_account
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=/bot/secrets/fakturabot-google-drive-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=FakturaBot
GOOGLE_DRIVE_DELETE_LOCAL_RECEIPT_ORIGINAL_AFTER_UPLOAD=1
GOOGLE_DRIVE_DELETE_LOCAL_INCOMING_INVOICE_ORIGINAL_AFTER_UPLOAD=1
GOOGLE_DRIVE_DELETE_LOCAL_INVOICE_PDF_AFTER_UPLOAD=0
GOOGLE_DRIVE_ARCHIVE_WORKER_INTERVAL_SECONDS=60
GOOGLE_DRIVE_ARCHIVE_WORKER_BATCH_SIZE=5
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o
DEBUG_INVOICE_TRANSPARENCY=0
DISABLE_INVOICE_FOLLOWUP_SCHEDULER=0
INVOICE_FOLLOWUP_CHECK_INTERVAL_SECONDS=86400
INVOICE_FOLLOWUP_NOTIFICATION_COOLDOWN_HOURS=24
DB_PATH=/bot/data/storage/fakturabot.db
STORAGE_DIR=/bot/data/storage
